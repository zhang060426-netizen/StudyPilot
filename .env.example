# Copy this file to .env and fill in your API key if you want online LLM responses.
# The app can still run in demo mode without an API key.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional iFlytek Spark X WebSocket credentials.
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=
SPARK_WS_URL=wss://spark-api.xf-yun.com/v1/x1
SPARK_DOMAIN=x1

# LLM_PROVIDER can be demo, deepseek, or spark.
LLM_PROVIDER=demo
